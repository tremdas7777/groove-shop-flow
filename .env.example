# MagicPay — chaves em Integrações no painel
# https://app.dashboardmagicpay.com/integrations
MAGICPAY_PUBLIC_KEY=
MAGICPAY_SECRET_KEY=
MAGICPAY_API_URL=https://api.dashboardmagicpay.com

# Senha inicial do /admin (opcional; senão a primeira senha criada no painel vale)
ADMIN_PIN=

# Token da UTMify (Integrações → Webhooks → Credenciais de API)
# Sem isso o isolate do checkout não consegue mandar venda pendente/paga
UTMIFY_API_TOKEN=

# Pixel do TikTok (Events Manager → Web) + token da Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# Store compartilhado opcional para live view entre isolates da Lovable
# ADMIN_STATE_URL=https://exemplo.com/admin-state.json
# ADMIN_STATE_TOKEN=
